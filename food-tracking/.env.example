# Optional cloud integration only. Local SQLite mode does not require this file.
# Copy to .env to enable the current Supabase auth and sync adapter.
# Supabase → Project Settings → API

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Optional: show guest login outside __DEV__ (temporary onboarding test)
# EXPO_PUBLIC_ENABLE_GUEST_LOGIN=true
